---
import Text from "@/components/foundations/elements/Text.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import { SITE } from "@/constants/site";
import { yearsSince } from "@/utils/date";

const years = yearsSince(SITE.CAREER_START);

const faqs = [
  {
    question: "Who is Abdallah Othman?",
    answer: `Abdallah Othman (AbdallahAHO) is a product engineer based in Hamburg, Germany, originally from Alexandria, Egypt. He's currently a Product Engineer on Growth at Langfuse (part of ClickHouse), with ${years}+ years building web products: onboarding, activation, pricing, and increasingly AI features like LLM agents and MCP.`
  },
  {
    question: "What does Abdallah Othman specialize in?",
    answer:
      "Product and growth engineering: the parts of a product that drive activation, conversion, retention, and monetization (onboarding, pricing and billing, experimentation). Lately, AI product work: LLM agents, MCP servers, and Claude-Code-driven workflows. Core stack: TypeScript, React, and Node."
  },
  {
    question: "Where does Abdallah Othman work?",
    answer:
      "He's a Product Engineer on Growth at Langfuse (part of ClickHouse), working remotely from Hamburg, Germany. Previously Lokalise, ABOUT YOU, XING, and Postman, where he was Technical Lead in Growth."
  },
  {
    question: "What is Abdallah Othman's background?",
    answer:
      "Self-taught from age 12 in Alexandria, Egypt, then a Computer Science degree and roles across German and global tech: ABOUT YOU, XING, Postman, Lokalise, and now Langfuse."
  },
  {
    question: "What technologies does Abdallah Othman use?",
    answer:
      "TypeScript, React, and Node day to day, plus AI/LLM tooling (MCP, agent frameworks, and Claude Code), and the usual growth stack for experimentation and analytics."
  },
  {
    question: "How can I contact Abdallah Othman?",
    answer:
      "Through his profiles: X/Twitter @AbdallahAHO, GitHub AbdallahAHO, and LinkedIn AbdallahAHO."
  }
];

// Single source of truth for the FAQPage structured data, derived from `faqs`
// so the schema can never drift from the visible copy.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<!-- Visually hidden: the FAQ copy stays in the DOM + the FAQPage JSON-LD
     below is always emitted. Note FAQ rich results were deprecated in 2023,
     so this is low-value but harmless to keep. -->
<section class="hidden">
  <Wrapper variant="standard" class="py-12 lg:py-32">
    <div class="border-t dark:border-white/10 border-black/10 pt-8">
      <Text
        tag="h2"
        variant="textBase"
        class="text-black dark:text-white font-medium mb-8"
      >
        Frequently Asked Questions
      </Text>

      <div class="space-y-6">
        {
          faqs.map((faq) => (
            <div class="border-b dark:border-white/10 border-black/10 pb-6 last:border-b-0">
              <Text
                tag="h3"
                variant="textSM"
                class="text-black dark:text-white font-medium mb-3"
              >
                {faq.question}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="dark:text-zinc-400 text-zinc-500"
              >
                {faq.answer}
              </Text>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>

<!-- FAQ Schema (derived from `faqs` above) -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
