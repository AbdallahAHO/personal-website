---
// Only tags NOT already emitted by astro-seo (Seo.astro) or BaseHead.
// title, description, keywords, author, robots and charset are owned by
// Seo.astro / BaseHead — duplicating them here shipped two <title>, two
// descriptions, two keywords/author and a second charset on every page.
---

<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
