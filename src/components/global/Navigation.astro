---
// Foundations
import Text from "@/components/foundations/elements/Text.astro";
import Button from "@/components/foundations/elements/Button.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
// Assets
import Logo from "@/components/global/Logo.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";

const navLinks = [
  {
    text: "Home",
    href: "/"
  },
  {
    text: "About",
    href: "/about"
  },
  {
    text: "Work",
    href: "/work"
  },
  {
    text: "Projects",
    href: "/projects/"
  },
  {
    text: "Blog",
    href: "/blog/"
  },
  {
    text: "Now",
    href: "/now"
  },
  {
    text: "CV",
    href: "/cv"
  },
  {
    text: "Contact",
    href: "mailto:contact@abdallahaho.com"
  }
];
// Split the navLinks array into two columns
const navLinksByColumn = [
  navLinks.slice(0, Math.ceil(navLinks.length / 2)), // Second column
  navLinks.slice(Math.ceil(navLinks.length / 2)) // First column
];
---

<header>
  <Wrapper class="bg-white dark:bg-black pt-14">
    <div class="flex flex-row items-center justify-between w-full">
      <Logo
        logoClass="dark:invert"
        class="dark:opacity-100 dark:hover:opacity-75"
      />
      <div class="ml-auto flex items-center gap-4">
        <Button
          size="medium"
          variant="secondary"
          aria-controls="mobile-menu"
          aria-haspopup="dialog"
          aria-label="Open navigation menu"
          data-menu-open
        >
          Menu
        </Button>
        <dialog
          id="mobile-menu"
          aria-label="Navigation menu"
          class="m-0 h-full max-h-none w-full max-w-none border-0 bg-white/50 p-0 text-inherit opacity-0 backdrop-blur-lg transition-[opacity,display,overlay] transition-discrete duration-200 backdrop:bg-transparent open:opacity-100 starting:open:opacity-0 dark:bg-black/50"
        >
          <Wrapper class="relative h-full pt-14">
            <div>
              <div class="flex items-center justify-between">
                <Logo logoClass="dark:invert" />
                <Button size="medium" variant="secondary" data-menu-close>
                  Close
                </Button>
              </div>
              <div class="grid grid-cols-1 gap-4 mt-8 md:grid-cols-2">
                {
                  navLinksByColumn.map((columnLinks) => (
                    <nav class="flex flex-col gap-y-4 col-start-2 md:col-start-auto">
                      {columnLinks.map((link) => (
                        <Text
                          tag="a"
                          variant="textSM"
                          href={link.href}
                          class="text-zinc-500 dark:text-zinc-400 dark:hover:text-white font-medium hover:text-black duration-300"
                        >
                          {link.text}
                        </Text>
                      ))}
                    </nav>
                  ))
                }
              </div>
            </div>
          </Wrapper>
        </dialog>
        <ThemeToggle />
      </div>
    </div>
  </Wrapper>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  document.querySelector("[data-menu-open]")?.addEventListener("click", () => menu?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => menu?.close());
</script>
