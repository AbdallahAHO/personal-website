{
  "name": "abdallah-othman-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "sync": "astro sync",
    "preview": "astro preview",
    "dev:network": "astro dev --host",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf node_modules dist .astro",
    "reinstall": "pnpm clean && pnpm install",
    "typecheck": "astro sync && astro check && tsc --noEmit",
    "test": "playwright test tests/build/",
    "test:smoke": "playwright test tests/smoke/",
    "test:all": "playwright test",
    "deploy": "pnpm build && wrangler pages deploy dist/",
    "lint:ci": "biome ci ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "astro-seo": "^1.2.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "vite": "^8.3.6",
    "vite-plugin-devtools-json": "^1.1.2",
    "wrangler": "^4.158.0"
  }
}
